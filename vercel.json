{
  "framework": "nextjs",
  "buildCommand": "next build",
  "installCommand": "npm install --production=false",
  "outputDirectory": ".next",
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- . ':(exclude)contracts' ':(exclude)scripts' ':(exclude)test' ':(exclude)hardhat.config.ts'",
  "functions": {
    "app/api/**/*.ts": {
      "runtime": "nodejs20.x",
      "maxDuration": 30
    }
  }
}
